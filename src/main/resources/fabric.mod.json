{
    "schemaVersion": 1,
    "id": "fma",
    "version": "${version}",
    "name": "flowey-monumenta-addons",
    "description": "Monumenta utilities",
    "authors": [
        "Flowey",
        "catgirljade_"
    ],
    "contact": {
        "repo": "https://github.com/flowey/flowey-monumenta-addons"
    },
    "license": "GPL-3.0",
    "icon": "assets/fma/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.floweytf.fma.FMAClient"
        ],
        "modmenu": [
            "com.floweytf.fma.compat.FMAConfigMenu"
        ]
    },
    "mixins": [
        "fma.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric": "*",
        "cloth-config": "*",
        "minecraft": "${minecraft_version}"
    },
    "suggests": {
        "modmenu": "*"
    },
    "accessWidener": "fma.accesswidener"
}